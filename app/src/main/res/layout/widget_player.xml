<?xml version="1.0" encoding="utf-8"?>
<!-- Player (DESIGN_SPEC.md 2.4). Everything is top|start with absolute margins that PlayerRenderer computes
     from the real widget size on one grid (title block / progress group / controls). The XML values describe a
     sample for the picker preview on Android < 15 only; the home screen never shows them. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/tile"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/nd_tile_r26" />

    <ImageView
        android:id="@+id/cover"
        android:layout_width="133dp"
        android:layout_height="133dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/preview_cover" />

    <LinearLayout
        android:id="@+id/text_block"
        android:layout_width="201dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="163dp"
        android:layout_marginTop="16dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/source"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/label_regular"
            android:includeFontPadding="false"
            android:letterSpacing="0.08"
            android:maxLines="1"
            android:text="SPOTIFY"
            android:textColor="@color/nd_dim"
            android:textSize="9.5dp" />

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="Midnight City"
            android:textColor="@color/nd_fg"
            android:textSize="17dp" />

        <TextView
            android:id="@+id/artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="M83"
            android:textColor="@color/nd_dim"
            android:textSize="13dp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/bar"
        android:layout_width="201dp"
        android:layout_height="7dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="163dp"
        android:layout_marginTop="80dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/preview_bar" />

    <FrameLayout
        android:id="@+id/time_row"
        android:layout_width="201dp"
        android:layout_height="14dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="163dp"
        android:layout_marginTop="91dp">

        <Chronometer
            android:id="@+id/elapsed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical"
            android:fontFamily="@font/label_regular"
            android:format="%s"
            android:includeFontPadding="false"
            android:letterSpacing="0.04"
            android:maxLines="1"
            android:textColor="@color/nd_fg"
            android:textSize="11dp" />

        <TextView
            android:id="@+id/remaining"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:fontFamily="@font/label_regular"
            android:includeFontPadding="false"
            android:letterSpacing="0.04"
            android:maxLines="1"
            android:text="−3:59"
            android:textColor="@color/nd_dim"
            android:textSize="11dp" />
    </FrameLayout>

    <ImageView
        android:id="@+id/controls"
        android:layout_width="144dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="220dp"
        android:layout_marginTop="101dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/preview_controls" />

    <!-- tap zones: transparent, on top of the rendered picture -->
    <ImageView
        android:id="@+id/zone_open"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/nd_zone_r26"
        android:contentDescription="@string/cd_open_player" />

    <ImageView
        android:id="@+id/zone_prev"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="220dp"
        android:layout_marginTop="101dp"
        android:background="@drawable/nd_zone_round"
        android:contentDescription="@string/cd_prev" />

    <ImageView
        android:id="@+id/zone_play"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="268dp"
        android:layout_marginTop="101dp"
        android:background="@drawable/nd_zone_round"
        android:contentDescription="@string/cd_play_pause" />

    <ImageView
        android:id="@+id/zone_next"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="316dp"
        android:layout_marginTop="101dp"
        android:background="@drawable/nd_zone_round"
        android:contentDescription="@string/cd_next" />
</FrameLayout>
