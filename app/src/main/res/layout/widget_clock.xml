<?xml version="1.0" encoding="utf-8"?>
<!-- Time widget: HH and mm are our own dot-matrix bitmaps (DotText), one red dot top-right. ClockWidgetProvider
     sizes and positions everything from the real widget size; the pv_* drawables only fill the picker preview
     on Android < 15 (on 15+ the generated preview is the real render). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/tile"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/nd_tile_r26" />

    <ImageView
        android:id="@+id/hours"
        android:layout_width="100dp"
        android:layout_height="63dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="46dp"
        android:layout_marginTop="22dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/pv_clock_h" />

    <ImageView
        android:id="@+id/minutes"
        android:layout_width="100dp"
        android:layout_height="63dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="46dp"
        android:layout_marginTop="108dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/pv_clock_m" />

    <ImageView
        android:id="@+id/dot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:importantForAccessibility="no"
        android:src="@drawable/nd_dot" />

    <ImageView
        android:id="@+id/zone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/nd_zone_r26"
        android:contentDescription="@string/cd_open_clock" />
</FrameLayout>
