<?xml version="1.0" encoding="utf-8"?>
<!-- Buds 2x1 (DESIGN_SPEC.md 2.6): dot earbuds glyph left, L / R and case levels (or one hero percent)
     right. The XML defaults are the picker preview; BudsWidgetProvider recomputes sizes from the real widget size. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/tile"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/nd_tile_r14" />

    <ImageView
        android:id="@+id/glyph"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="12dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/preview_buds" />

    <LinearLayout
        android:id="@+id/col"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="62dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/hero"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/hero"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/nd_fg"
            android:textSize="28dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/line1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/space_mono_regular"
            android:includeFontPadding="false"
            android:letterSpacing="0.08"
            android:maxLines="2"
            android:text="L 80 · R 75"
            android:textColor="@color/nd_fg"
            android:textSize="11dp" />

        <TextView
            android:id="@+id/line2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="@font/space_mono_regular"
            android:includeFontPadding="false"
            android:letterSpacing="0.08"
            android:maxLines="1"
            android:text="CASE 40"
            android:textColor="@color/nd_dim"
            android:textSize="11dp" />
    </LinearLayout>

    <!-- accent: a bud at or below 15%; hidden in the preview -->
    <ImageView
        android:id="@+id/dot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:importantForAccessibility="no"
        android:src="@drawable/nd_dot"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/zone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/nd_zone_r14"
        android:contentDescription="@string/cd_open_bluetooth" />
</FrameLayout>
