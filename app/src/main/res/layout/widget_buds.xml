<?xml version="1.0" encoding="utf-8"?>
<!-- Buds 2x1 (DESIGN_SPEC.md 2.6): earbuds picture left (pv_buds.png, tools/buds_art.mjs); right: model name, L / R dot-matrix readouts,
     case level. BudsWidgetProvider positions everything from the real size; the defaults only fill the picker
     preview on Android < 15. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/tile"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/nd_tile_r14" />

    <ImageView
        android:id="@+id/pic"
        android:layout_width="62dp"
        android:layout_height="42dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/pv_buds" />

    <ImageView
        android:id="@+id/badge"
        android:layout_width="11dp"
        android:layout_height="11dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="82dp"
        android:layout_marginTop="10dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/name"
        android:layout_width="40.5dp"
        android:layout_height="7dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="82dp"
        android:layout_marginTop="12dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/pv_buds_name" />

    <ImageView
        android:id="@+id/read_l"
        android:layout_width="32dp"
        android:layout_height="14dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="82dp"
        android:layout_marginTop="25dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/pv_buds_read" />

    <ImageView
        android:id="@+id/read_r"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="82dp"
        android:layout_marginTop="25dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/sub"
        android:layout_width="40.75dp"
        android:layout_height="7dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="82dp"
        android:layout_marginTop="42dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/pv_buds_case" />

    <ImageView
        android:id="@+id/zone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/nd_zone_r14"
        android:contentDescription="@string/cd_open_bluetooth" />
</FrameLayout>
