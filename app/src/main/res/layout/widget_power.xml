<?xml version="1.0" encoding="utf-8"?>
<!-- Power 3x1 (DESIGN_SPEC.md 2.5): hero percent left, 10-dot bar + status label right. The XML defaults
     are the picker preview; PowerWidgetProvider recomputes sizes from the real widget size. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/tile"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/nd_tile_r14" />

    <LinearLayout
        android:id="@+id/hero_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="14dp"
        android:gravity="bottom"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/pct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/hero"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="77"
            android:textColor="@color/nd_fg"
            android:textSize="32dp" />

        <TextView
            android:id="@+id/unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:fontFamily="@font/space_mono_regular"
            android:includeFontPadding="false"
            android:letterSpacing="0.08"
            android:maxLines="1"
            android:text="%"
            android:textColor="@color/nd_dim"
            android:textSize="12dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/col"
        android:layout_width="110dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="12dp"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/bar"
            android:layout_width="110dp"
            android:layout_height="11dp"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/preview_power_bar" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:fontFamily="@font/space_mono_regular"
            android:includeFontPadding="false"
            android:letterSpacing="0.08"
            android:maxLines="1"
            android:text="ON BATTERY"
            android:textColor="@color/nd_dim"
            android:textSize="10dp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/zone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/nd_zone_r14"
        android:contentDescription="@string/cd_open_battery" />
</FrameLayout>
