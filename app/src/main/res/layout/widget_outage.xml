<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tile"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/nd_tile_r22">

    <TextView
        android:id="@+id/outage_fallback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="@string/outage_widget_label"
        android:textColor="@color/nd_fg"
        android:textSize="13sp" />

    <ImageView android:id="@+id/outage_header" android:layout_width="wrap_content" android:layout_height="wrap_content" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/outage_off_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/outage_off_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/outage_on_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/outage_on_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/outage_divider" android:layout_width="1dp" android:layout_height="wrap_content" android:background="@color/nd_stroke" android:importantForAccessibility="no" android:visibility="gone" />
    <ImageView android:id="@+id/outage_day_bar" android:layout_width="wrap_content" android:layout_height="wrap_content" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/outage_second_bar" android:layout_width="wrap_content" android:layout_height="wrap_content" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/outage_today_detail" android:layout_width="wrap_content" android:layout_height="wrap_content" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/outage_tomorrow_detail" android:layout_width="wrap_content" android:layout_height="wrap_content" android:importantForAccessibility="no" />

    <FrameLayout
        android:id="@+id/zone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/nd_zone_r22" />
</FrameLayout>
