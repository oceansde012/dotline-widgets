<?xml version="1.0" encoding="utf-8"?>
<!-- ND_Head 5x1: date (TextClock, rolls over by itself) left, next alarm right. HeadWidgetProvider sets
     paddings, text size and the tap targets from the real size (DESIGN_SPEC.md 2.1). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/tile"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/nd_tile_r22" />

    <TextClock
        android:id="@+id/date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="14dp"
        android:fontFamily="@font/space_mono_regular"
        android:format12Hour="EEE d MMM"
        android:format24Hour="EEE d MMM"
        android:includeFontPadding="false"
        android:letterSpacing="0.08"
        android:maxLines="1"
        android:textAllCaps="true"
        android:textColor="@color/nd_fg"
        android:textSize="13dp" />

    <TextView
        android:id="@+id/alarm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="14dp"
        android:fontFamily="@font/space_mono_regular"
        android:includeFontPadding="false"
        android:letterSpacing="0.08"
        android:maxLines="1"
        android:text="ALARM 07:30"
        android:textAllCaps="true"
        android:textColor="@color/nd_dim"
        android:textSize="13dp" />

    <!-- tap zones: left = calendar, right = alarms -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/zone_date"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/nd_zone_flat"
            android:contentDescription="@string/cd_open_calendar" />

        <ImageView
            android:id="@+id/zone_alarm"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/nd_zone_flat"
            android:contentDescription="@string/cd_open_alarms" />
    </LinearLayout>
</FrameLayout>