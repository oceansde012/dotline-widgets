<?xml version="1.0" encoding="utf-8"?>
<!-- Head 5x1: big dot day number, weekday + month in the label font, alarm (bell + time) right.
     HeadWidgetProvider positions everything from the real size (DESIGN_SPEC.md 2.1). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/tile"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/nd_tile_r22" />

    <ImageView
        android:id="@+id/day"
        android:layout_width="55dp"
        android:layout_height="35dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="14dp"
        android:layout_marginTop="12dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/pv_head_day" />

    <LinearLayout
        android:id="@+id/date_col"
        android:layout_width="90dp"
        android:layout_height="35dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="80dp"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/weekday"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/label_medium"
            android:includeFontPadding="false"
            android:letterSpacing="0.04"
            android:maxLines="1"
            android:text="FRI"
            android:textColor="@color/nd_fg"
            android:textSize="12dp" />

        <TextView
            android:id="@+id/month"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:fontFamily="@font/label_regular"
            android:includeFontPadding="false"
            android:letterSpacing="0.04"
            android:maxLines="1"
            android:text="OCT"
            android:textColor="@color/nd_dim"
            android:textSize="11dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/alarm_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/bell"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:importantForAccessibility="no"
            android:scaleType="fitXY" />

        <TextView
            android:id="@+id/alarm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:fontFamily="@font/label_regular"
            android:includeFontPadding="false"
            android:letterSpacing="0.04"
            android:maxLines="1"
            android:text="07:30"
            android:textColor="@color/nd_dim"
            android:textSize="12dp" />
    </LinearLayout>

    <!-- tap zones: left = calendar, right = alarms -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/zone_date"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/nd_zone_flat"
            android:contentDescription="@string/cd_open_calendar" />

        <ImageView
            android:id="@+id/zone_alarm"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/nd_zone_flat"
            android:contentDescription="@string/cd_open_alarms" />
    </LinearLayout>
</FrameLayout>
