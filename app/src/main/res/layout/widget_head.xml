<?xml version="1.0" encoding="utf-8"?>
<!-- Head 5x1: big dot day number, weekday + month labels, next alarm (label + dot time) or an honest
     empty state on the right. Labels are bitmaps (LabelText): a launcher may swap the font of a hosted
     TextView. HeadWidgetProvider positions everything from the real size (DESIGN_SPEC.md 2.1). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/tile"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/nd_tile_r22" />

    <ImageView
        android:id="@+id/day"
        android:layout_width="55dp"
        android:layout_height="35dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="14dp"
        android:layout_marginTop="12dp"
        android:scaleType="fitXY"
        android:src="@drawable/pv_head_day" />

    <ImageView
        android:id="@+id/weekday"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="80dp"
        android:layout_marginTop="12dp"
        android:scaleType="fitXY" />

    <ImageView
        android:id="@+id/month"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="80dp"
        android:layout_marginTop="30dp"
        android:scaleType="fitXY" />

    <ImageView
        android:id="@+id/month_dots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/alarm_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:scaleType="fitXY"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/alarm_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:visibility="gone" />

    <!-- tap zones: left = calendar, right = alarms -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/zone_date"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/nd_zone_flat"
            android:contentDescription="@string/cd_open_calendar" />

        <ImageView
            android:id="@+id/zone_alarm"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/nd_zone_flat"
            android:contentDescription="@string/cd_open_alarms" />
    </LinearLayout>
</FrameLayout>
