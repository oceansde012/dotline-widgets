<?xml version="1.0" encoding="utf-8"?>
<!-- Weather 2x2 (DESIGN_SPEC.md 2.3): dot icon top-left, dot-matrix temperature in the middle, condition +
     H/L at the bottom. WeatherWidgetProvider positions everything from the real size; the defaults are only
     the picker preview on Android < 15. Labels are bitmaps (LabelText), see there for why. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/tile"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/nd_tile_r26" />

    <ImageView
        android:id="@+id/icon"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/preview_wx" />

    <ImageView
        android:id="@+id/city"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="64dp"
        android:layout_marginTop="28dp"
        android:scaleType="fitXY"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/temp"
        android:layout_width="97dp"
        android:layout_height="45dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="16dp"
        android:layout_marginTop="57dp"
        android:scaleType="fitXY"
        android:src="@drawable/pv_wx_temp" />

    <ImageView
        android:id="@+id/label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="16dp"
        android:layout_marginTop="108dp"
        android:scaleType="fitXY" />

    <ImageView
        android:id="@+id/sub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="16dp"
        android:layout_marginTop="124dp"
        android:scaleType="fitXY" />

    <!-- accent: rain within 2 h; hidden in the preview -->
    <ImageView
        android:id="@+id/dot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:importantForAccessibility="no"
        android:src="@drawable/nd_dot"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/zone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/nd_zone_r26"
        android:contentDescription="@string/cd_open_weather" />
</FrameLayout>
